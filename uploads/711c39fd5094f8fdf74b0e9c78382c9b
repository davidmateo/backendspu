
-- =============================
-- 🔹 ESTRUCTURA
-- =============================

DROP TABLE IF EXISTS actividad_usuario CASCADE;
DROP TABLE IF EXISTS comentario CASCADE;
DROP TABLE IF EXISTS like_podcast CASCADE;
DROP TABLE IF EXISTS solicitudes_creador CASCADE;
DROP TABLE IF EXISTS podcast CASCADE;
DROP TABLE IF EXISTS usuario CASCADE;
DROP TABLE IF EXISTS estado CASCADE;
DROP TABLE IF EXISTS rol CASCADE;

-- 🔹 Tabla rol
CREATE TABLE rol (
  id_rol SERIAL PRIMARY KEY,
  nombre_rol VARCHAR(50)
);

-- 🔹 Tabla estado
CREATE TABLE estado (
  id SERIAL PRIMARY KEY,
  nombre VARCHAR(50)
);

-- 🔹 Tabla usuario
CREATE TABLE usuario (
  uid VARCHAR PRIMARY KEY,
  nombre VARCHAR,
  email VARCHAR,
  fecha_registro TIMESTAMP,
  refresh_token TEXT,
  id_rol INTEGER,
  apellido VARCHAR,
  fecha_actualizacion TIMESTAMP,
  fecha_creacion TIMESTAMP,
  FOREIGN KEY (id_rol) REFERENCES rol(id_rol)
);

-- 🔹 Tabla podcast
CREATE TABLE podcast (
  id_podcast SERIAL PRIMARY KEY,
  titulo VARCHAR,
  description TEXT,
  url_audio TEXT,
  fecha_subida TIMESTAMP,
  uid VARCHAR,
  imagen TEXT,
  estado_id INTEGER,
  FOREIGN KEY (uid) REFERENCES usuario(uid),
  FOREIGN KEY (estado_id) REFERENCES estado(id)
);

-- 🔹 Tabla solicitudes
CREATE TABLE solicitudes_creador (
  id SERIAL PRIMARY KEY,
  uid_firebase VARCHAR,
  nombre VARCHAR,
  correo VARCHAR,
  nuevo_uid VARCHAR,
  estado_id INTEGER,
  fecha_solicitud TIMESTAMP,
  FOREIGN KEY (uid_firebase) REFERENCES usuario(uid),
  FOREIGN KEY (estado_id) REFERENCES estado(id)
);

-- 🔹 Tabla likes
CREATE TABLE like_podcast (
  id_like SERIAL PRIMARY KEY,
  fecha_like TIMESTAMP,
  uid VARCHAR,
  id_podcast INTEGER,
  FOREIGN KEY (uid) REFERENCES usuario(uid),
  FOREIGN KEY (id_podcast) REFERENCES podcast(id_podcast)
);

-- 🔹 Tabla comentario
CREATE TABLE comentario (
  id_comentario SERIAL PRIMARY KEY,
  contenido TEXT,
  fecha_comentario TIMESTAMP,
  uid VARCHAR,
  id_podcast INTEGER,
  FOREIGN KEY (uid) REFERENCES usuario(uid),
  FOREIGN KEY (id_podcast) REFERENCES podcast(id_podcast)
);

-- 🔹 Tabla actividad
CREATE TABLE actividad_usuario (
  id SERIAL PRIMARY KEY,
  usuario VARCHAR,
  tipo_accion TEXT,
  fecha_hora TIMESTAMP,
  leida BOOLEAN DEFAULT FALSE
);

